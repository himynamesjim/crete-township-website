# Database connection string (Neon PostgreSQL)
DATABASE_URI=

# Used to encrypt JWT tokens
PAYLOAD_SECRET=

# Vercel Blob storage for file uploads (documents and media)
BLOB_READ_WRITE_TOKEN=

# Site URL (used for CORS, links, etc.)
NEXT_PUBLIC_SITE_URL=

# Secret used to authenticate cron jobs
CRON_SECRET=

# Used to validate preview requests
PREVIEW_SECRET=

# Google Calendar — secret ICS URL (get from Google Calendar settings → "Secret address in iCal format")
GOOGLE_CALENDAR_ICS_URL=

# Facebook API credentials for Recent News feed
# Option 1: Use a Page Access Token (recommended)
FACEBOOK_ACCESS_TOKEN=

# Option 2: Use App ID + App Secret (will auto-generate token)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Mailgun — email delivery for newsletter subscriber notifications
# Sign up at mailgun.com → Sending → Domains → Add Domain → get API key
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# e.g. Crete Township <notifications@mail.cretetownship.com>
MAILGUN_FROM_EMAIL=
